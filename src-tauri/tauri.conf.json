{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ollama-monitor",
  "version": "1.0.0",
  "identifier": "com.jordanbrinkman.com",
  "build": {
    "beforeDevCommand": "npm run dev:next:webpack",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:next:webpack",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ollama Monitor",
        "decorations": false,
        "width": 800,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "minimizable": true,
        "closable": true,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "settings",
        "title": "Ollama Monitor Settings",
        "url": "/settings",
        "width": 800,
        "height": 720,
        "visible": false,
        "transparent": true,
        "minimizable": true,
        "decorations": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
